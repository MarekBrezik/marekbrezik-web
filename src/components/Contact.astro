---
---

<section id="kontakt" class="section contact" aria-label="Kontakt">
  <div class="container contact-grid">
    <div class="contact-intro reveal">
      <p class="label contact-label">Kontakt</p>
      <h2 class="headline contact-title">
        Plánujete novostavbu nebo rekonstrukci?
      </h2>
      <p class="body-lg contact-lead">
        Řekněte nám, co od svého domu očekáváte. Ozveme se zpátky.
      </p>
    </div>

    <form
      id="contact-form"
      class="contact-form reveal stagger-1"
      action="/api/contact"
      method="POST"
      novalidate
    >
      <div class="form-row">
        <div class="form-field">
          <label for="name">Jméno</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="form-field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
      </div>

      <div class="form-field">
        <label for="phone">Telefon</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" />
      </div>

      <div class="form-field">
        <label for="message">Krátká zpráva</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>

      {/* Honeypot field — hidden from humans. */}
      <div class="form-field hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn form-submit">
        Odeslat poptávku
        <span aria-hidden="true">→</span>
      </button>

      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const messages = {
    success: 'Děkujeme. Brzy se vám ozveme.',
    error: 'Odeslání se nepodařilo. Zkuste to prosím znovu, nebo nám napište přímo na e-mail.',
    missing: 'Vyplňte prosím jméno, e-mail a zprávu.',
    invalid: 'Zkontrolujte prosím formát e-mailu.',
  };

  const params = new URLSearchParams(window.location.search);
  const status = params.get('status');
  const statusEl = document.getElementById('form-status');

  if (status && statusEl && messages[status]) {
    statusEl.textContent = messages[status];
    // Clean the query string so the message disappears on refresh.
    if (window.history.replaceState) {
      window.history.replaceState({}, '', window.location.pathname + window.location.hash);
    }
  }
</script>

<style>
  .contact {
    background: var(--bg-soft);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-label {
    margin-bottom: 1.5rem;
  }

  .contact-title {
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }

  .contact-lead {
    max-width: 38ch;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-field label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .form-field input,
  .form-field textarea {
    padding: 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--rule);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--spot);
    box-shadow: 0 0 0 3px rgba(255, 77, 0, 0.08);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  /* Honeypot: hidden from real users. */
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .form-submit {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .form-status {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .form-submit {
      width: 100%;
      justify-content: center;
    }
  }
</style>
