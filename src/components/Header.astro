---

<header class="header">
  <div class="container header-inner">
    <a href="#" class="logo" aria-label="Domů">mb.</a>
    <nav class="nav" aria-label="Hlavní navigace">
      <a href="#reseni" class="nav-link">Řešení</a>
      <span class="nav-divider" aria-hidden="true">/</span>
      <a href="#kontakt" class="nav-link">Kontakt</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .nav-link {
    padding: 0.25rem 0.125rem;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-divider {
    color: var(--rule);
    user-select: none;
  }
</style>
