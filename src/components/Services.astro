---
const services = [
  {
    index: "01",
    title: "Deye",
    desc: "Fotovoltaika, baterie a řízení energie. Řešení výhradně v LV.",
  },
  {
    index: "02",
    title: "FVE",
    desc: "Výroba a uchovávání vlastní energie jako základ chytrého domu.",
  },
  {
    index: "03",
    title: "WallBox",
    desc: "Chytré nabíjení elektromobilu propojené s energetickým systémem domu.",
  },
  {
    index: "04",
    title: "KNX",
    desc: "Profesionální řízení a automatizace technologií domu.",
  },
  {
    index: "05",
    title: "Home Assistant",
    desc: "Integrace, vlastní logika řízení a propojení celého ekosystému.",
  },
];
---

<section id="reseni" class="section services" aria-labelledby="reseni-heading">
  <div class="container">
    <div class="services-header reveal">
      <span class="label">Řešení</span>
      <h2 id="reseni-heading" class="headline services-lead">
        Od výroby energie po řízení domu.
      </h2>
    </div>

    <hr class="rule reveal" />

    <ol class="services-list">
      {
        services.map((service, i) => (
          <li class={`service-item reveal stagger-${i + 1}`}>
            <span class="service-index" aria-hidden="true">{service.index}</span>
            <div class="service-body">
              <h3 class="service-title">{service.title}</h3>
              <p class="body service-desc">{service.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    background: var(--bg-soft);
  }

  .services-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 3rem;
  }

  .services-lead {
    max-width: 18ch;
  }

  .services-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .service-item {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    transition: background 0.2s ease;
  }

  .service-item:nth-child(3n) {
    border-right: 0;
  }

  .service-item:hover {
    background: var(--bg);
  }

  .service-index {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--spot);
    opacity: 0.7;
  }

  .service-title {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .service-desc {
    max-width: 32ch;
  }

  .service-item:last-child .service-desc {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .services-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-item:nth-child(3n) {
      border-right: 1px solid var(--rule);
    }

    .service-item:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 900px) {
    .services-header {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 640px) {
    .services-list {
      grid-template-columns: 1fr;
    }

    .service-item {
      border-right: 0;
      padding: 2rem 0;
    }

    .service-item:nth-child(3n),
    .service-item:nth-child(2n) {
      border-right: 0;
    }
  }
</style>
