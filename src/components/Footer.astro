---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copy">© {year} Marek Březík</p>
    <p class="footer-note">Chytrá energie a automatizace domu.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-copy,
  .footer-note {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
