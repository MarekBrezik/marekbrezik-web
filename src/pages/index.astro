---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Idea from "../components/Idea.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";

const title = "Marek Březík — Chytrá energie a automatizace domu";
const description =
  "Propojujeme energie a technologie tak, aby váš dům fungoval jako jeden celek. Deye, FVE, WallBox, KNX, Home Assistant.";
const canonical = "https://marekbrezik.cz";
const ogImage = "https://marekbrezik.cz/og.png";
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="cs_CZ" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Fonts: none. System font stack for speed and simplicity. -->
  </head>

  <body>
    <Header />
    <main>
      <Hero />
      <Services />
      <Idea />
      <Contact />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>
